---
import NotesList from "./NotesList.astro";

const { sections, listTitle = "Temas" } = Astro.props;
---

<aside class="topics bg-grid">
  <h2 class="topic">{listTitle}</h2>
  <nav>
    {
      Array.isArray(sections) &&
        sections.map(
          (files: any) =>
            files.length > 0 && (
              <NotesList title={files[0].frontmatter.block} files={files} />
            )
        )
    }
  </nav>
</aside>

<style>
  .topics {
    max-width: 550px;
    padding: 20px;
    overflow-y: auto;
    border: 1px solid var(--black);
  }

  .topic {
    margin: 60px 0 10px 0;
    background-color: var(--black);
    color: var(--white) !important;
    text-align: center;
    padding: 10px;
  }

  @media (max-width: 1000px) {
    .topics {
      display: none;
      position: fixed;
      z-index: 2;
      background-color: var(--bg-color);
      height: 100dvh;
      width: 65%;
    }

    .topic {
      margin: 0 0 10px 0;
    }
  }
</style>
