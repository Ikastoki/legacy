---
import Menu from "../../components/notes/Menu.astro";
import Topics from "../../components/notes/Topics.astro";
import Layout from "../Layout.astro";

const pageTitle = "Apuntes Terminal";

const sections = [
  await Astro.glob("../../pages/markdown/herramientas/terminal/conceptos/*.md"),
  await Astro.glob(
    "../../pages/markdown/herramientas/terminal/comandos-basicos/*.md"
  ),
  await Astro.glob(
    "../../pages/markdown/herramientas/terminal/permisos-propiedades/*.md"
  ),
];
---

<Layout title={pageTitle}>
  <section class="content-wrapper">
    <Topics
      sections={sections}
      bgColor="red"
      textColor="blue"
      listTitle="Terminal"
    />

    <main class="markdown-content">
      <slot />
    </main>
  </section>

  <Menu />
</Layout>
