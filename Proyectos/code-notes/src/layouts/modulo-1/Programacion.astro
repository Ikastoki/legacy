---
import Menu from "../../components/notes/Menu.astro";
import Topics from "../../components/notes/Topics.astro";
import Layout from "../Layout.astro";

const pageTitle = "Apuntes Programación";

const sections = [
  await Astro.glob("../../pages/markdown/modulo-1/programacion/conceptos/*.md"),
  await Astro.glob("../../pages/markdown/modulo-1/programacion/logica/*.md"),
];
---

<Layout title={pageTitle}>
  <section class="content-wrapper">
    <Topics sections={sections} bgColor="red" textColor="blue" listTitle="Programación"/>

    <main class="markdown-content">
      <slot />
    </main>
  </section>

  <Menu />
</Layout>
