---
import Menu from "../../components/notes/Menu.astro";
import Topics from "../../components/notes/Topics.astro";
import Layout from "../Layout.astro";

const pageTitle = "Apuntes SASS";

const sections = [
  await Astro.glob("../../pages/markdown/modulo-2/sass/basico/*.md"),
  await Astro.glob(
    "../../pages/markdown/modulo-2/sass/reutilizacion-logica/*.md"
  ),
  await Astro.glob("../../pages/markdown/modulo-2/sass/avanzado/*.md"),
];
---

<Layout title={pageTitle}>
  <section class="content-wrapper">
    <Topics
      sections={sections}
      bgColor="red"
      textColor="blue"
      listTitle="SASS"
    />

    <main class="markdown-content">
      <slot />
    </main>
  </section>

  <Menu />
</Layout>
