---
import Menu from "../../components/notes/Menu.astro";
import Topics from "../../components/notes/Topics.astro";
import Layout from "../Layout.astro";

const pageTitle = "Apuntes Node";

const sections = [
  await Astro.glob(
    "../../pages/markdown/modulo-3/javascript-node/conceptos/*.md"
  ),
  await Astro.glob(
    "../../pages/markdown/modulo-3/javascript-node/modulos-nativos/*.md"
  ),
  await Astro.glob(
    "../../pages/markdown/modulo-3/javascript-node/paquetes-de-terceros/*.md"
  ),
];
---

<Layout title={pageTitle}>
  <section class="content-wrapper">
    <Topics
      sections={sections}
      bgColor="red"
      textColor="blue"
      listTitle="Node"
    />

    <main class="markdown-content">
      <slot />
    </main>
  </section>

  <Menu />
</Layout>
