---
import Menu from "../../components/notes/Menu.astro";
import Topics from "../../components/notes/Topics.astro";
import Layout from "../Layout.astro";

const pageTitle = "Apuntes TypeScript";

const sections = [
  await Astro.glob("../../pages/markdown/modulo-3/typescript/conceptos/*.md"),
  await Astro.glob(
    "../../pages/markdown/modulo-3/typescript/principios-basicos/*.md"
  ),
  await Astro.glob("../../pages/markdown/modulo-3/typescript/poo/*.md"),
  await Astro.glob("../../pages/markdown/modulo-3/typescript/mix/*.md"),
  await Astro.glob("../../pages/markdown/modulo-3/typescript/web/*.md"),
];
---

<Layout title={pageTitle}>
  <section class="content-wrapper">
    <Topics
      sections={sections}
      bgColor="red"
      textColor="blue"
      listTitle="TypeScript"
    />

    <main class="markdown-content">
      <slot />
    </main>
  </section>

  <Menu />
</Layout>
