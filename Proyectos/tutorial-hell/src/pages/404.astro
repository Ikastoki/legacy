---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <main class="not-found">
    <div class="container">
      <div class="not-found__content">
        <svg
          class="not-found__illustration"
          viewBox="0 0 200 120"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <circle
            cx="100"
            cy="50"
            r="40"
            stroke="currentColor"
            stroke-width="3"
            opacity="0.2"></circle>
          <circle
            cx="100"
            cy="50"
            r="28"
            stroke="currentColor"
            stroke-width="2"
            opacity="0.15"></circle>
          <circle
            cx="100"
            cy="50"
            r="16"
            stroke="currentColor"
            stroke-width="1.5"
            opacity="0.1"></circle>
          <line
            x1="62"
            y1="34"
            x2="138"
            y2="66"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            opacity="0.3"></line>
          <line
            x1="62"
            y1="66"
            x2="138"
            y2="34"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            opacity="0.3"></line>
          <circle cx="100" cy="44" r="4" fill="currentColor" opacity="0.4"
          ></circle>
          <path
            d="M93 56 Q100 62 107 56"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            opacity="0.4"></path>
          <text
            x="100"
            y="110"
            text-anchor="middle"
            font-size="20"
            font-weight="800"
            fill="currentColor"
            opacity="0.08">404</text
          >
          <path
            d="M100 10 L103 22 L115 22 L105 30 L109 42 L100 34 L91 42 L95 30 L85 22 L97 22 Z"
            fill="currentColor"
            opacity="0.08"></path>
        </svg>

        <h1 class="not-found__title">Página no encontrada</h1>
        <p class="not-found__message">
          Vaya, parece que te has desviado del camino...<br />
          Esta página no existe o la hemos movido a otra ruta.
        </p>

        <a href="/" class="not-found__btn"
          >&larr; Volver a la página principal</a
        >

        <!-- <div class="not-found__search">
          <p class="not-found__search-label">
            ¿Buscabas algo en concreto? Prueba con el buscador:
          </p>
          <form class="not-found__search-form" id="notFoundSearchForm">
            <input
              type="text"
              id="notFoundSearchInput"
              class="not-found__search-input"
              placeholder="Buscar cursos, rutas..."
              aria-label="Buscar"
            />
            <button type="submit" class="not-found__search-btn">Buscar</button>
          </form>
        </div> -->

        <nav class="not-found__links">
          <h3>Enlaces útiles</h3>
          <ul>
            <li><a href="/">Inicio</a></li>
            <li><a href="/#allCoursesSection">Cursos</a></li>
            <li><a href="/#routesSection">Rutas de aprendizaje</a></li>
            <li><a href="/informacion">Información</a></li>
          </ul>
        </nav>
      </div>
    </div>
  </main>

  <Footer />

  <!-- <script>
    const form = document.getElementById("notFoundSearchForm");
    const input = document.getElementById("notFoundSearchInput");

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      const q = input.value.trim();
      window.location.href = "/" + (q ? "?q=" + encodeURIComponent(q) : "");
    });
  </script> -->
</Layout>

<style>
  /* .not-found {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: fadeIn 0.4s ease both;
  } */

  .not-found__content {
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
    padding: 40px 0;
  }

  .not-found__illustration {
    width: 160px;
    height: auto;
    margin-bottom: 24px;
    color: var(--text-primary);
  }

  .not-found__title {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.5px;
    margin-bottom: 12px;
  }

  .not-found__message {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .not-found__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 28px;
    border-radius: 50px;
    background: var(--accent);
    color: var(--text-inverse);
    font-weight: 600;
    font-size: 0.95rem;
    transition:
      background var(--transition),
      transform var(--transition);
    text-decoration: none;
    margin-bottom: 40px;
  }

  .not-found__btn:hover {
    background: var(--accent-hover);
    transform: scale(1.02);
  }

  .not-found__search {
    margin-bottom: 40px;
  }

  .not-found__search-label {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 12px;
  }

  .not-found__search-form {
    display: flex;
    gap: 8px;
    max-width: 400px;
    margin: 0 auto;
  }

  .not-found__search-input {
    flex: 1;
    padding: 10px 16px;
    border: 2px solid var(--border);
    border-radius: 50px;
    background: var(--bg-input);
    color: var(--text-primary);
    font-size: 0.9rem;
    outline: none;
    transition: border-color var(--transition);
  }

  .not-found__search-input:focus {
    border-color: var(--accent);
  }

  .not-found__search-btn {
    padding: 10px 20px;
    border-radius: 50px;
    border: none;
    background: var(--accent);
    color: var(--text-inverse);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background var(--transition);
    white-space: nowrap;
  }

  .not-found__search-btn:hover {
    background: var(--accent-hover);
  }

  .not-found__links h3 {
    font-size: 0.95rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .not-found__links ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .not-found__links a {
    display: block;
    padding: 8px 18px;
    border-radius: 50px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition:
      border-color var(--transition),
      color var(--transition);
  }

  .not-found__links a:hover {
    border-color: var(--card-hover-border);
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .not-found__title {
      font-size: 1.5rem;
    }

    .not-found__message {
      font-size: 0.95rem;
    }

    .not-found__search-form {
      flex-direction: column;
    }
  }
</style>
